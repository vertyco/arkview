; arkviewer systemd template unit (Ubuntu / Debian).
;
; ONE template, MANY instances - one instance per ARK map you want to expose.
; The ``%i`` placeholder below is replaced with whatever comes after the ``@``
; in the instance name, so:
;
;   sudo systemctl start  arkviewer@ragnarok.service
;   sudo systemctl start  arkviewer@theisland.service
;   sudo systemctl restart arkviewer@ragnarok.service
;   sudo systemctl status arkviewer@theisland.service
;   sudo systemctl enable arkviewer@ragnarok.service   # auto-start at boot
;
; Per-instance layout assumed:
;
;   /opt/arkviewer/                  one shared install
;   /opt/arkviewer/.venv/            Python venv with requirements + arkparser
;   /opt/arkviewer/main.py           shared source
;   /opt/arkviewer/maps/ragnarok/    one directory per map instance
;     └─ config.ini                  THIS map's config.ini (Port=, MapFilePath=, ...)
;   /opt/arkviewer/maps/theisland/
;     └─ config.ini
;
; Each instance gets its own ``ARKVIEWER_CONFIG`` env var pointing at its
; config.ini, so the single shared install runs N separate processes (one
; per map) each reading a different config + listening on a different port.
;
; Install:
;   sudo install -m 0644 deploy/arkviewer@.service /etc/systemd/system/arkviewer@.service
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now arkviewer@ragnarok.service arkviewer@theisland.service
;
; Logs:
;   journalctl -u arkviewer@ragnarok -f

[Unit]
Description=ArkViewer (%i) - FastAPI parser/API for the %i ARK map
Documentation=https://github.com/vertyco/arkview
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=arkviewer
Group=arkviewer
WorkingDirectory=/opt/arkviewer

; Tell arkviewer which config.ini to load for THIS instance.
Environment=ARKVIEWER_CONFIG=/opt/arkviewer/maps/%i/config.ini

ExecStart=/opt/arkviewer/.venv/bin/python /opt/arkviewer/main.py

Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s
KillSignal=SIGINT

; --- Sandboxing / hardening ---
; arkviewer only needs to read the ARK save directory + read+write the ban
; file (if configured) + read+write its own log file. Tighten everything else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectSystem=strict
ProtectHome=true
; ReadOnlyPaths covers the ARK save tree (arkviewer never writes saves).
; Adjust this to wherever your ARK servers store their saves.
ReadOnlyPaths=/srv/ark
; ReadWritePaths is for arkviewer's own runtime files (logs, ban list).
ReadWritePaths=/opt/arkviewer/maps/%i
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false   ; pydantic_core compiled extension uses W+X mmap on some builds
SystemCallArchitectures=native

; --- Resource limits (tune to your busiest map) ---
LimitNOFILE=8192
; ARK saves are big; allow generous memory for parse spikes.
MemoryHigh=2G
MemoryMax=4G

[Install]
WantedBy=multi-user.target
